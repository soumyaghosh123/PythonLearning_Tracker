config.json
data/
dashboard.html
plan.html

# Python cache
__pycache__/
*.pyc

# Generated by setup (machine-specific)
languages/javascript/hook.json
languages/java/agent/*.jar
languages/java/agent/*.class
languages/java/agent/agent.properties
